  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The majority holds that the district court lacked jurisdiction over this class action because 8 U.S.C. 1252(g) bars claims arising from the decision or action to execute removal orders, rejecting the First Circuit's reading that 1252(g) reaches only discretionary choices and not challenges to the legality of how removal is carried out; it disposes of the case on that jurisdictional ground without deciding whether the third-country removal Guidance satisfies 8 U.S.C. 1231(b), FARRA/CAT, or the Due Process Clause."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The majority states a categorical rule reaching beyond these plaintiffs: programmatic district-court challenges (APA or class actions) to the procedures by which the government executes final removal orders are foreclosed as a class, not just on this record; the opinion expressly reserves, rather than decides, whether an individual noncitizen may raise a constitutional or torture-based claim through habeas or a petition for review."
    }
  ],
