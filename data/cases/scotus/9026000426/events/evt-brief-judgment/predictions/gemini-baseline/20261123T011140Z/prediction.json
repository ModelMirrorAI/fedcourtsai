  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The majority holds under the plain text of 8 U.S.C. \u00a7 1252(f)(1), extending Garland v. Aleman Gonzalez, 596 U.S. 543 (2022), and applying California v. Grace Brethren Church, 457 U.S. 393 (1982), that lower federal courts lack authority to 'enjoin or restrain the operation' of 8 U.S.C. \u00a7 1231 through classwide declaratory judgments or APA \u00a7 706 vacatur orders that practically check or dictate executive implementation of third-country removals."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The majority confines its holding to statutory remedial and procedural challenges to classwide or universal relief under 8 U.S.C. \u00a7\u00a7 1231 and 1252(f)(1), declining to abolish APA \u00a7 706 vacatur across administrative law generally and leaving open individualized as-applied habeas or injunctive challenges by a specific noncitizen facing imminent persecution or torture without notice."
    }
  ],
