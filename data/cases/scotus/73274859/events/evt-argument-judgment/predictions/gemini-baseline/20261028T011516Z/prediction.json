  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The Court holds that the structure of the Constitution and the Clean Air Act, under American Electric Power Co. v. Connecticut and International Paper Co. v. Ouellette, preclude applying affected-state (Colorado) tort law to impose liability for injuries allegedly caused by interstate and global greenhouse-gas emissions, after first holding that the Colorado Supreme Court's Rule 21 original-proceeding ruling is reviewable under 28 U.S.C. 1257(a) pursuant to Atlantic Richfield Co. v. Christian and Cox Broadcasting Corp. v. Cohn."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The Court adopts a categorical rule barring affected-state common-law tort claims that seek damages for injuries mediated through interstate and global greenhouse-gas emissions\u2014regardless of whether plaintiffs frame those claims as targeting upstream fossil-fuel production, promotion, and deceptive marketing rather than direct point-source emissions\u2014while leaving undisturbed Ouellette's preservation of traditional source-state claims for localized pollution."
    }
  ],
