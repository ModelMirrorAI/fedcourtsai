  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "Section 717f(h)'s delegation of federal eminent-domain power carries the federal Fifth Amendment measure of compensation, rather than incorporating state compensation law. The majority will treat the statute's silence as leaving that federal rule in place, not as a gap requiring Kimbell Foods borrowing; North Dakota therefore cannot add attorney fees to the compensation owed here."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The majority will announce a rule for the measure of compensation in private condemnations under the Natural Gas Act generally, not an attorney-fee-only exception or a rule confined to these landowners. It will not hold that private pipeline companies acquire all sovereign immunities of the United States."
    }
  ],
