    {
      "call_source": "transcript_item",
      "params_digest": "a9156cbc2aa0c544",
      "query": "{\"content\": \"P(grant) 0.65. The prior-Term (OT 2024) salience base rate for a paid petition reaching the `high` band (sal-v3) is 42.6%. I adjust this figure up significantly because the petition touches a core priority of the current conservative majority: the dismantling of DEI initiatives and the bounds of the First Amendment right of expressive association after *303 Creative*. The lower court held that a bar association's diversity quotas for leadership positions are protected by the First A",
      "result_capture": "unobserved",
      "result_digest": null,
      "result_status": "unobserved",
      "retrieved_doc_date": null,
