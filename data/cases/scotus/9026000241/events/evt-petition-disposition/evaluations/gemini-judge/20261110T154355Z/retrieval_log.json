    {
      "call_source": "transcript_item",
      "params_digest": "52a6aeb5f35eb9fb",
      "query": "for c in codex-baseline claude-baseline gemini-baseline; do\n  echo \"=== $c prediction.json ===\"\n  cat data/cases/scotus/9026000241/record/blinded/$c/prediction.json\n  echo \"=== $c reasoning.md ===\"\n  cat data/cases/scotus/9026000241/record/blinded/$c/reasoning.md\n  echo \"=== $c predicted_reasoning.md ===\"\n  cat data/cases/scotus/9026000241/record/blinded/$c/predicted_reasoning.md\n  echo \"=== $c retrieval.md ===\"\n  cat data/cases/scotus/9026000241/record/blinded/$c/retrieval.md\ndone",
      "result_capture": "outcome_only",
