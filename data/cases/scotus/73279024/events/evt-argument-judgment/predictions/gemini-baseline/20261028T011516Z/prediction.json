  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The Court holds that the Air Force's submission of a RCRA permit-renewal application to Guam EPA is not 'final agency action' under the APA, 5 U.S.C. 704, and Bennett v. Spear, 520 U.S. 154 (1997), because an application merely initiates rather than consummates the regulatory permitting process and any interim continuation of operations during Guam EPA's review flows by operation of Guam law from the prior 2018 permit rather than from any legal determination in the 2021 renewal application."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The Court resolves the case narrowly on the first question presented (APA final agency action) and declines to decide the second question presented regarding whether RCRA's permitting scheme or 42 U.S.C. 4336(a) categorically displaces NEPA review when a federal agency applies for a state or territorial RCRA permit."
    }
  ],
