  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The majority holds that Stinson's Seminole Rock-style deference no longer states the rule: Guidelines commentary that interprets a guideline binds a court only where the guideline is genuinely ambiguous after exhausting the traditional tools of construction, under the Kisor v. Wilkie framework (not the unqualified 'plainly erroneous or inconsistent' test of Stinson), and the Fifth Circuit erred by deferring under Stinson without that inquiry."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The holding is a categorical rule governing all Guidelines commentary in every case, not a ruling confined to Application Note 2 to USSG 2K2.1 or the 'large capacity magazine' term; the Court does not itself decide whether that term is ambiguous or whether petitioner's 17-round magazine qualifies, but leaves application to the court of appeals on remand."
    }
  ],
