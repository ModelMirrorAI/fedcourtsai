  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The Court holds that Stinson v. United States incorporated Bowles v. Seminole Rock & Sand Co. rather than a freestanding rule of reflexive deference, so courts may defer to Sentencing Guidelines commentary only when, under Kisor v. Wilkie, a Guideline remains genuinely ambiguous after exhausting traditional tools of construction and the commentary's reading is reasonable and satisfies Kisor's character-and-context markers."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The Court announces a general doctrinal rule governing all interpretive Sentencing Guidelines commentary nationwide under Stinson and Kisor, while declining to decide the case-specific application of U.S.S.G. \u00a7 2K2.1(a)(3) Application Note 2 or harmless error and remanding those issues to the Fifth Circuit."
    }
  ],
