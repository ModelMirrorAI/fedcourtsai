  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The Court holds that Colorado's Universal Preschool Program equal-opportunity requirement is not generally applicable under Employment Division v. Smith, Fulton v. City of Philadelphia, and Tandon v. Newsom\u2014and reinforces under Carson v. Makin that excluding religious schools for maintaining faith-based community admissions burdens religious exercise\u2014because the regulatory scheme permits discretionary programmatic preferences (8 CCR 1404-1 \u00a7 4.109) and categorical disability and income exceptions that undermine the State's asserted equal-access interest, and the refusal to exempt Catholic preschools fails strict scrutiny."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The majority resolves the case within existing Free Exercise doctrine by applying Fulton, Tandon, and Carson to Colorado's preschool program and its regulatory exemptions, without overruling Employment Division v. Smith or holding that every facially neutral nondiscrimination condition on government funding automatically triggers strict scrutiny."
    }
  ],
