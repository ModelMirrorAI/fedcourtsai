  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "Section 511(a) does not preclude district-court jurisdiction over a standalone constitutional challenge to a veterans' benefits statute: deciding the statute's validity is not necessary to a Secretary's decision applying that statute, and the VJRA preserves Robison's distinction between challenges to statutory validity and challenges to agency administration."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The holding establishes a general district-court route for constitutional attacks on the validity of veterans' benefits statutes, not an exception confined to Johnson's incarceration or Section 5313, while leaving challenges to agency interpretation and administration within the VJRA review scheme."
    }
  ],
