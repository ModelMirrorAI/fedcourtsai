  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The majority holds that 38 U.S.C. 511(a) does not strip federal district courts of jurisdiction under 28 U.S.C. 1331 to hear facial constitutional challenges to acts of Congress affecting veterans' benefits, relying on the plain text of 'necessary to a decision by the Secretary under a law'\u2014which encompasses applying statutes as written rather than adjudicating their validity, as confirmed by the Board of Veterans' Appeals' binding inability under 38 C.F.R. 20.105 to declare statutes unconstitutional\u2014and the prior-construction canon carrying forward Johnson v. Robison, 415 U.S. 361 (1974)."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The majority adopts a categorical statutory rule preserving federal-question jurisdiction in district courts for standalone facial constitutional challenges to acts of Congress affecting veterans' benefits while leaving intact the VJRA's exclusive channeling of as-applied challenges and challenges to VA regulations and individual benefits determinations."
    }
  ],
