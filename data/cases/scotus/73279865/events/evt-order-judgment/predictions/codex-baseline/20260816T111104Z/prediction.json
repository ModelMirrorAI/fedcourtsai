  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "Section 511(a) bars review of questions necessary to a benefits decision by the Secretary, but a facial challenge to the validity of a veterans-benefits statute contests Congress's enactment rather than a decision of the Secretary; the VJRA's specialized review provisions therefore did not abrogate Johnson v. Robison or displace district-court jurisdiction under 28 U.S.C. \u00a7 1331."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The Court will preserve district-court jurisdiction categorically for genuine facial constitutional challenges to Acts of Congress affecting veterans' benefits, while leaving ordinary benefits disputes and as-applied claims that require review of an individual VA determination in the VJRA channel."
    }
  ],
