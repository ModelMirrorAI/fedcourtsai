  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The Court holds that under the plain text and grammar of 28 U.S.C. 2244(b)(2)(A), the phrase 'that was previously unavailable' modifies 'a new rule of constitutional law, made retroactive to cases on collateral review by the Supreme Court,' rather than 'the claim,' so availability depends on whether this Court had announced the retroactive constitutional rule before the prior federal habeas petition concluded, not on whether the prisoner's claim had 'some possibility of merit' under the evidentiary record, diagnostic manuals, or non-retroactive case law."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The Court announces a categorical statutory interpretation of 28 U.S.C. 2244(b)(2)(A) rejecting the Fifth Circuit's 'some possibility of merit' test and holding across the board that a constitutional rule announced by this Court before a prisoner's prior federal habeas petition is not 'previously unavailable' under Section 2244(b)(2)(A), while declining to decide whether changes in diagnostic standards could ever render an execution challenge newly ripe on a non-successive theory under Panetti v. Quarterman."
    }
  ],
