  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The majority holds that whether a rule was 'previously unavailable' under 28 U.S.C. 2244(b)(2)(A) turns on whether this Court had announced the rule before the prisoner's earlier federal habeas application, not on whether a claim under it would then have had some possibility of merit; it rejects the Fifth Circuit's In re Cathey merit/futility test (siding with the Eleventh and Fourth Circuits) and treats post-Atkins changes in clinical criteria such as the DSM-5 as new factual predicates governed, and here barred, by 2244(b)(2)(B)(ii), so Johnson's Atkins claim cannot proceed."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The holding is a general rule for every successive state (2244) and federal (2255(h)(2)) application, not a ruling limited to Atkins or DSM claims, but the Court expressly reserves the question of a rule announced while the first federal habeas application was still pending, deciding only the case of a rule announced before that application was filed."
    }
  ],
