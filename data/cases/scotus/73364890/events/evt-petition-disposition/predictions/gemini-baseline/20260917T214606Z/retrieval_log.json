    {
      "call_source": "transcript_item",
      "params_digest": "6bc349148123674b",
      "query": "{\"content\": \"P(grant) 0.01. The prior-Term salience band for a paid, baseline petition strictly before Term 2025 is ~4.5-5.9%. I adjust this significantly down to 1% because the Solicitor General waived the right to respond on June 16, 2026. A waiver by the United States is a strong negative signal, as it indicates the government believes the petition has no reasonable chance of being granted and does not raise a significant circuit split or vehicle. Petitions that go to conference with a waived",
      "result_capture": "unobserved",
