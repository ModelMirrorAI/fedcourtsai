  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The majority holds, on the text of 15 U.S.C. 77k(a) and by extending Omnicare and Macquarie (the Rule 10b-5(b) 'half-truths, not pure omissions' reading) to Section 11(a)'s misleading-omissions prong, that materiality of omitted interim financial information and misleading effect are two distinct elements: a plaintiff must identify a specific affirmative statement in the registration statement and show that the omission made that statement misleading in context (including surrounding hedges and disclaimers), so the Ninth Circuit erred in treating a finding of materiality as itself establishing the duty to disclose."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The majority states its rule categorically for every Section 11(a) misleading-omissions claim rather than confining it to Robinhood's offering or to interim-results cases, but it stops there: it does not itself apply the two-element test to Robinhood's registration statement, does not adopt or reject the First Circuit's 'extreme departure' standard as the measure of materiality, and does not reach Item 303 or the required-statements prong, leaving all of that for remand."
    }
  ],
