  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The majority will hold that Section 11(a)'s misleading-omissions prong requires an independent determination that omitted material information makes an identified affirmative statement misleading; materiality of interim financial results does not itself establish that requirement, and the Ninth Circuit's merger of the inquiries conflicts with the statutory text and Omnicare."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The majority will announce a rule governing misleading-omissions claims involving interim financial information generally, but leave the application to Robinhood's particular disclosures and the separate Item 303 required-disclosure theory for further proceedings, without creating a categorical exemption for information not yet due under quarterly reporting rules."
    }
  ],
