      "params_digest": "f9de52dc9ca53bdb",
      "query": "for c in claude-baseline codex-baseline gemini-baseline; do\n  echo \"=== $c prediction.json ===\"\n  cat data/cases/scotus/9026000107/record/blinded/$c/prediction.json\n  echo \"=== $c reasoning.md ===\"\n  cat data/cases/scotus/9026000107/record/blinded/$c/reasoning.md\n  echo \"=== $c predicted_reasoning.md ===\"\n  cat data/cases/scotus/9026000107/record/blinded/$c/predicted_reasoning.md\n  echo \"=== $c retrieval.md ===\"\n  cat data/cases/scotus/9026000107/record/blinded/$c/retrieval.md\ndone",
      "result_capture": "outcome_only",
