  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "Extending Hana Financial, Inc. v. Hana Bank and USPTO v. Booking.com B.V. under the U.S. Bank N.A. v. Village at Lakeridge mixed-question framework, the majority holds that a trademark's inherent or conceptual strength in a Lanham Act likelihood-of-confusion inquiry turns on the commercial impression the mark conveys to ordinary consumers in marketplace context\u2014making it a predominantly factual determination governed by Rule 56's reasonable-jury standard at summary judgment and Rule 52(a) clear-error review, rather than a legal question like patent claim construction (Markman) or copyright fair use (Google v. Oracle)."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The majority announces a categorical rule across federal trademark infringement litigation that conceptual/inherent mark strength is a factual issue rather than a question of law, while cabining its judgment to vacatur and remand by preserving Rule 56 summary judgment where no reasonable jury could find conceptual strength and leaving to the Second Circuit in the first instance whether PepsiCo is entitled to summary judgment under that standard or on alternative Polaroid factors."
    }
  ],
