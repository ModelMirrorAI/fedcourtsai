    },
    {
      "call_source": "transcript_item",
      "params_digest": "e944309910986836",
      "query": "sed -n '85,220p' /tmp/statpack-at/codex-baseline/statpack.md && jq '[.terms[] | select(.term>=2017 and .term<2026) | .segments[] | select(.band==\"federal\") | {denom:.prefix_weighted_resolved, numer:(.prefix_weighted_resolved * .prefix_est_grant_rate)}] | {resolved: (map(.denom)|add), grants:(map(.numer)|add), rate: ((map(.numer)|add)/(map(.denom)|add))}' /tmp/statpack-at/codex-baseline/statpack.json",
      "result_capture": "outcome_only",
