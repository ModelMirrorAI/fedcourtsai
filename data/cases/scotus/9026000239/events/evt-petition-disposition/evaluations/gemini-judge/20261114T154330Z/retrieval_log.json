    {
      "call_source": "transcript_item",
      "params_digest": "31aeb9f4b470cd58",
      "query": "for c in codex-baseline claude-baseline gemini-baseline; do echo \"=== $c ===\"; UV_CACHE_DIR=/tmp/uv-cache uv run fedcourts statpack-at \"data/cases/scotus/9026000239/record/blinded/$c/\" --ref origin/main --out-dir \"/tmp/statpack-at/$c\" || echo \"statpack-at exited $?\" ; done",
