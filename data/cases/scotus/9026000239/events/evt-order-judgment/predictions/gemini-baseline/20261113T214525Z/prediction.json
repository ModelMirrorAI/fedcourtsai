  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "Extending Trump v. Hawaii and Garland v. Aleman Gonzalez, the majority holds that because granting asylum under 8 U.S.C. 1158(b)(1)(A) is discretionary, a lawful Section 1182(f) entry-suspension proclamation categorically foreclosing discretionary grants of asylum relieves the Executive of any obligation under Section 1158(a)(1) or (b)(2)(C) to accept or adjudicate futile asylum applications, and independently holds that 8 U.S.C. 1252(f)(1) barred the district court's classwide injunction because prohibiting non-statutory removals and requiring asylum processing orders federal officials how to implement and carry out Part IV removal procedures under Sections 1225(b) and 1229a."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The majority resolves the merits on statutory harmonization of Sections 1182(f) and 1158(b)(1)(A) and Section 1252(f)(1)'s remedial bar across the certified class, while stopping short of holding either that Article II confers inherent extra-statutory expulsion power or that Section 1182(f) authorizes summary removals inside the United States that bypass Part IV's statutory procedures or mandatory withholding of removal under Section 1231(b)(3) and Convention Against Torture protections."
    }
  ],
