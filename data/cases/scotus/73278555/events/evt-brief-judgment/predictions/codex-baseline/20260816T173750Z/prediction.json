  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The Court will hold that Rule 8 and ERISA's context-specific duty of prudence require assessing all well-pleaded allegations together, so an underperformance-based claim has no categorical requirement to identify a better-performing fund with matching objectives, risks, and rewards, although comparability remains important to whether imprudence is plausibly inferred."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The holding will be narrow: it will reject a threshold meaningful-benchmark rule for ERISA pleadings, preserve dismissal when the allegations viewed as a whole do not plausibly exclude prudent differences in strategy or risk, and remand without deciding that Intel's investment process was imprudent."
    }
  ],
