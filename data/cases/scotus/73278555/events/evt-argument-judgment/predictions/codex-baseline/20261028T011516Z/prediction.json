  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The majority will uphold a meaningful-comparison requirement for an inference of ERISA imprudence drawn from relative fund underperformance as an application of ordinary Twombly/Iqbal plausibility, rather than an impermissible heightened pleading rule: performance differences between funds pursuing materially different investment objectives do not themselves plausibly indicate a defective fiduciary process."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The majority will state a generally applicable but bounded rule for underperformance-based allegations, not a universal comparator prerequisite for ERISA prudence claims; it will expressly permit comparisons between funds with different asset allocations when the comparison remains meaningful in light of the challenged investment objectives and risks."
    }
  ],
