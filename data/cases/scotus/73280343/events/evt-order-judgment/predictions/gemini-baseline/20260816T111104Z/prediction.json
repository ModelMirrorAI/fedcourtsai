  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The Court holds that the phrase 'granted asylum' in 8 U.S.C. \u00a7 1159(b) plainly refers to the historical fact of having been granted asylum, and does not require a noncitizen to maintain a continuing, present status of asylum to be eligible for adjustment to lawful permanent resident status."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The Court's holding categorically applies to all noncitizens seeking adjustment of status under Section 1159(b) who were previously granted asylum, concluding that the statute's plain text unambiguously allows adjustment eligibility regardless of whether their asylum was later terminated."
    }
  ],
