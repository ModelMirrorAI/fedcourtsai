  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The Court holds that under 28 U.S.C. \u00a7 2241 and Preiser v. Rodriguez, a federal prisoner's claim that earned time credits under the First Step Act (18 U.S.C. \u00a7\u00a7 3624(g), 3632(d)(4)(C)) entitle him to accelerated transfer out of a prison facility into prerelease custody in a halfway house or home confinement challenges the fact or duration of physical imprisonment and is therefore cognizable in habeas corpus."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The Court adopts a narrow rule limited to claims seeking accelerated release out of a prison facility into community prerelease custody (a residential reentry center or home confinement), expressly declining to decide whether transfers between different prison facilities or security levels within prison are cognizable in habeas and leaving alternative defenses such as administrative exhaustion and 18 U.S.C. \u00a7 3621(b) for remand."
    }
  ],
