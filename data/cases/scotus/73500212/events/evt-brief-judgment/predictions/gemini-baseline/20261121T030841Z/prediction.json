  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "Extending Taggart v. Lorenzen, 587 U.S. 554 (2019), and Fed. R. Civ. P. 65(d), the majority holds that civil contempt requires no fair ground of doubt under the injunction's operative text, disapproving the Ninth Circuit's 'spirit of the injunction' rule, confining McComb v. Jacksonville Paper Co., 336 U.S. 187 (1949), to contextual reading of express terms and prospective modification rather than unstated obligations, and holding that subjective bad faith cannot turn an objectively reasonable reading of an order into contempt."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The majority states a categorical, trans-substantive rule governing civil contempt of federal-court injunctions generally\u2014refusing to confine Taggart to bankruptcy or carve out antitrust and unfair-competition decrees\u2014while preserving prospective injunction modification and contextual reading of express decree terms rather than requiring magic-words hyper-literalism."
    }
  ],
