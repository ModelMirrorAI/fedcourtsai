  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "Applying the two-step separation-of-powers framework of Ziglar v. Abbasi, Egbert v. Boule, and Goldey v. Fields rather than overruling Bivens under stare decisis, the majority holds that Watanabe's Eighth Amendment medical-care claim arises in a new Bivens context from Carlson v. Green and is foreclosed by special factors\u2014specifically the non-fatal, ongoing nature of the alleged mistreatment where administrative, injunctive, and FTCA remedies were accessible, alongside Congress's post-Carlson enactment of the PLRA and the Bureau of Prisons Administrative Remedy Program."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The majority declines Petitioner's request to formally overrule Bivens, Davis v. Passman, or Carlson v. Green across the board ('this far and no further'), leaving Fourth and Fifth Amendment Bivens precedents untouched while adopting a rule categorical enough across post-PLRA, non-fatal federal prison medical disputes to foreclose Eighth Amendment Bivens medical-indifference suits beyond Carlson's own facts."
    }
  ],
