  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The majority holds that Watanabe's claim presents a new Bivens context because the circumstances of the alleged medical mistreatment, including the official's knowledge and affirmative contribution to the injury and the absence of Carlson's rapidly fatal emergency, are meaningfully different from Carlson; special factors then preclude extending the damages remedy. It does not treat the shared Eighth Amendment deliberate-indifference label as sufficient to establish an existing context."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The majority distinguishes this nonfatal, nonemergency treatment claim while leaving Carlson available within its core context; it does not announce that every federal-prison medical-care damages claim is barred or overrule Bivens altogether."
    }
  ],
