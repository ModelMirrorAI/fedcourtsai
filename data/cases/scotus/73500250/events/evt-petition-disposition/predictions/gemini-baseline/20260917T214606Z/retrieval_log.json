    },
    {
      "call_source": "transcript_item",
      "params_digest": "267e8394bc63629f",
      "query": "{\"content\": \"P(grant) 0.08. \\n\\nThe petition sits in the `baseline` salience band (a private individual petitioning against the United States in a criminal matter). Anchoring on the strictly-prior Terms (2024 back to 2017) for the `baseline` band, the bracketed \\\"reached\\\" rate over those terms sits firmly around 5%. \\n\\nI adjust this base rate slightly upward to 8% for two main reasons. First, the Solicitor General initially filed a waiver of the right to respond, but the Court subsequently req",
      "result_capture": "unobserved",
      "result_digest": null,
      "result_status": "unobserved",
      "retrieved_doc_date": null,
