  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The majority holds, on the original public meaning of 'trial by an impartial jury' as applied in Ramos v. Louisiana, that the Sixth Amendment (incorporated against the States through the Fourteenth) requires a 12-member jury to convict of a serious offense, and expressly overrules Williams v. Florida, rejecting Williams's functionalist reasoning rather than holding that Ramos had already silently overruled it."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The holding is a categorical rule reaching every State's trials for serious (non-petty) offenses, not one confined to Florida's six-person felony juries or to Kian; the Court leaves retroactivity, harmless-error and preservation questions for remand and pending cases rather than limiting the rule's reach in the opinion itself."
    }
  ],
