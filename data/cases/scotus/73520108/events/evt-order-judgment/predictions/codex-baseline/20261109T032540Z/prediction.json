  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The majority holds that Section 362(k)'s private damages remedy does not displace the FAA's requirement to enforce these arbitration agreements: core-bankruptcy status and generalized interests in centralization, expertise, uniformity, and deterrence do not establish the requisite congressional intent, particularly because arbitration leaves the bankruptcy court's own contempt-enforcement authority intact."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The majority announces a generally applicable arbitrability rule for private Section 362(k) damages claims, not a rule limited to discharged Chapter 7 debtors; it reserves the treatment of Section 105(a) contempt proceedings and does not hold that every core bankruptcy proceeding must be arbitrated."
    }
  ],
