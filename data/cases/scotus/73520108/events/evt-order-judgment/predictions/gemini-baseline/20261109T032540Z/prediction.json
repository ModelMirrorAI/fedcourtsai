  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "Applying the conflict standard of Shearson/American Express, Inc. v. McMahon and Epic Systems Corp. v. Lewis, the majority will hold that neither 11 U.S.C. \u00a7 362(k) nor the Bankruptcy Code's general policies of centralization, uniformity, and judicial expertise express a clear and manifest congressional command to displace the Federal Arbitration Act for private automatic-stay damages claims, distinguishing a debtor's statutory damages action under \u00a7 362(k) from a bankruptcy court's inherent and \u00a7 105(a) civil-contempt power."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The majority will adopt a rule reaching beyond closed Chapter 7 proceedings to hold that private \u00a7 362(k) damages claims are generally subject to arbitration under the FAA unless enforcing the arbitration agreement would directly interfere with the ongoing administration or distribution of the bankruptcy estate, while leaving intact the bankruptcy court's non-arbitrable authority over \u00a7 105(a) contempt proceedings and equitable administration of an active estate."
    }
  ],
