    {
      "call_source": "transcript_item",
      "params_digest": "d39d86e2db46cf8b",
      "query": "python3 -c \"\nimport json\nfor snap in ['2026-10-31.json', '2026-11-16.json']:\n    print('===', snap, '===')\n    d = json.load(open(f'data/cases/scotus/9026000372/record/snapshots/{snap}'))\n    for p in d.get('proceedings', []):\n        print(p.get('Date'), '|', p.get('Text'))\n\"",
      "result_capture": "outcome_only",
