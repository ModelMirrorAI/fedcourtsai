      "query": "python3 -c \"\nimport json\nd = json.load(open('data/cases/scotus/9026000372/record/snapshots/2026-11-16.json'))\nfor k, v in d.items():\n    if k != 'ProceedingsandOrder':\n        print(f'{k}: {v}')\nprint('--- ProceedingsandOrder ---')\nfor p in d.get('ProceedingsandOrder', []):\n    print(p.get('Date'), '|', p.get('Text'))\n\" && rm -rf /tmp/statpack-at",
