    {
      "call_source": "transcript_item",
      "params_digest": "b4bf92d659e0cda0",
      "query": "cat << 'EOF' > /tmp/calc_scores.py\nimport json\n\nbase_rate = 0.05120250431778929\nbase_brier = (base_rate - 0)**2\n\nprobs = {\n  \"gemini-baseline\": 0.005,\n  \"claude-baseline\": 0.006,\n  \"codex-baseline\": 0.025\n}\n\nfor c, p in probs.items():\n  brier = p**2\n  skill = 1 - brier / base_brier\n  print(f\"{c}: brier={brier}, skill={skill}\")\nEOF\npython3 /tmp/calc_scores.py",
