  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The majority will hold that the plain text of the VPPA's 'consumer' definition\u2014'goods or services'\u2014is unqualified and therefore encompasses all goods or services offered by a video tape service provider, relying on the presumption of meaningful variation because Congress expressly limited the 'personally identifiable information' definition to 'video materials' but omitted that limitation for 'consumer'."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The majority will establish a categorical rule that any individual who rents, purchases, or subscribes to any good or service from a covered video tape service provider qualifies as a 'consumer' under the VPPA, rejecting any purposive limitation to audiovisual transactions."
    }
  ],
