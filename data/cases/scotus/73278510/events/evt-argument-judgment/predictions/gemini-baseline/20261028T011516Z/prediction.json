  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The Court holds that 'goods or services from a video tape service provider' in 18 U.S.C. \u00a7 2710(a)(1)'s definition of 'consumer' takes its ordinary meaning and encompasses any good or service from such a provider without an implied audiovisual limitation, relying on the meaningful variation between unmodified 'goods or services' in \u00a7 2710(a)(1) and 'specific video materials or services' in \u00a7 2710(a)(3)."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The Court announces a categorical statutory construction of 'consumer' in 18 U.S.C. \u00a7 2710(a)(1) rather than a fact-specific holding tied to online newsletters, while expressly leaving open for remand unpresented threshold defenses including whether the defendant is a 'video tape service provider' under \u00a7 2710(a)(4) and whether pixel transmissions constitute 'personally identifiable information' under \u00a7 2710(a)(3)."
    }
  ],
