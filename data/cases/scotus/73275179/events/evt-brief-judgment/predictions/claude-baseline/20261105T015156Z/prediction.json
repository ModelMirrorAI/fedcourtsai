  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The majority holds that AR-15-platform and similar semiautomatic rifles are 'Arms' under the plain text, rejecting the Seventh Circuit's (Bevis) move of treating 'military-style' weapons as outside the text, and that under Heller's common-use rule (grounded in the 'dangerous and unusual' tradition) an arm commonly possessed by law-abiding citizens for lawful purposes cannot be categorically banned; it rejects the Second Circuit's 'unusually dangerous' historical-analogue test and the respondents' trap-gun/Bowie-knife analogues as a basis for a possession ban, treating Heller and Bruen as having already done the historical work."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The holding is a categorical rule, not a fact-bound remand: outright possession bans on arms in common use are unconstitutional, applied to the AR-15 class as a whole on the basis of its nationwide ownership and lawfulness in most States, without a case-specific empirical record of self-defense use; but the majority expressly reserves magazine-capacity limits, feature-based regulation short of a ban, and machine guns, and does not fix a numeric threshold for 'common use'."
    }
  ],
