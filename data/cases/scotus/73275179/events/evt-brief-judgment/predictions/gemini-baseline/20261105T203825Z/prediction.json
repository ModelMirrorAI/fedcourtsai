  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "Applying District of Columbia v. Heller (2008), New York State Rifle & Pistol Ass'n v. Bruen (2022), and Wolford v. Lopez (2026), the majority holds that semiautomatic rifles are bearable 'Arms' covered by the Second Amendment's plain text and that because AR-15 platform and similar semiautomatic rifles are owned by millions of Americans in common use for lawful purposes including self-defense, they cannot be banned under the historical tradition of prohibiting 'dangerous and unusual' weapons."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The majority announces a categorical constitutional rule invalidating flat prohibitions on the possession of AR-15 platform and functionally similar semiautomatic rifles by law-abiding citizens across both consolidated cases, while distinguishing fully automatic machineguns and leaving regulations of non-rifle firearms or magazine capacity outside the holding."
    }
  ],
