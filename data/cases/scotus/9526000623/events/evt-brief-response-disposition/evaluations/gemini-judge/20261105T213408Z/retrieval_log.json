    {
      "call_source": "transcript_item",
      "params_digest": "ce66631fa06311f3",
      "query": "python3 -c '\nimport math\nfor cid, p in [(\"claude-baseline\", 0.01), (\"codex-baseline\", 0.03), (\"gemini-baseline\", 0.015)]:\n    brier = (p - 0.0) ** 2\n    ll = -math.log(1.0 - p)\n    print(f\"{cid}: p={p}, brier={brier:.10f}, log_loss={ll:.10f}\")\n'",
      "result_capture": "outcome_only",
      "result_digest": null,
      "result_status": "ok",
      "retrieved_doc_date": null,
