  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The Court holds that 8 U.S.C. 1188(g)(2) authorizes the Department of Labor to impose civil money penalties and award back wages administratively\u2014contrasting Congress's authorization for 'imposing appropriate penalties' with 'seeking appropriate injunctive relief' in court\u2014and that Article III's public-rights exception under Oceanic Steam Navigation Co. v. Stranahan permits non-Article III adjudication of monetary remedies against employers who violate germane H-2A guestworker admission and labor-certification conditions."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The majority cabins its Article III holding narrowly to sovereign immigration and temporary guestworker-admission programs where employer obligations are germane conditions of foreign-worker entry, declining to endorse the Government's broad trans-substantive theory for federal benefits, licenses, or privileges generally and leaving SEC v. Jarkesy's limits on in-house civil penalties intact outside historically recognized public-rights categories."
    }
  ],
