  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "Applying Jarkesy's Article III private-rights presumption, the majority holds that DOL's binding adjudication of H-2A employment-related monetary liability falls outside the immigration public-rights exception: adjudicating workplace obligations resembling contract claims is distinct from deciding admission, exclusion, or immigration status, notwithstanding the employer's participation in a federal visa program."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The majority states a rule governing H-2A employment-related monetary adjudications generally, not merely Sun Valley's particular violations, but expressly leaves administrative monetary penalties within other established public-rights categories and immigration-status enforcement unresolved rather than requiring every agency civil penalty to be adjudicated in court."
    }
  ],
