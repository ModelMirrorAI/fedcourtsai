  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The Court will hold that under the plain text of Federal Rule of Civil Procedure 8(c), a defendant must affirmatively plead an affirmative defense in its answer, and cannot raise it for the first time at summary judgment without amending the pleading, as doing so would circumvent the good-cause requirement for modifying a scheduling order under Rule 16(b)(4)."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The holding will establish a categorical procedural rule applying to all affirmative defenses in federal civil litigation, rather than a narrow ruling dependent on the specific timeline or prejudice to the plaintiff in this case."
    }
  ],
