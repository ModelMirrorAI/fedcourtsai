  "semantic_claims": [
    {
      "claim_id": "majority-ground",
      "proposition": "The Court holds that under the plain text and structure of Federal Rules of Civil Procedure 8(c)(1), 15(a), and 16(b)(4), a defendant that failed to plead an affirmative defense in its answer cannot assert that defense for the first time in a summary judgment motion unless it satisfies the governing standards for amending its answer under Rule 15(a) and, where a scheduling order deadline has expired, Rule 16(b)(4)'s good-cause requirement, rejecting the Eleventh Circuit's standalone no-prejudice rule."
    },
    {
      "claim_id": "ground-breadth",
      "proposition": "The Court issues a narrow procedural holding confined to the Rule 15 and Rule 16(b)(4) standards governing unpleaded affirmative defenses at summary judgment (permitting district courts to treat a summary judgment motion as a constructive motion to amend if those substantive standards are met), while declining to decide in the first instance whether Title VII's personal-staff exclusion in 42 U.S.C. 2000e(f) is an affirmative defense or an element of the plaintiff's claim and leaving that issue and any forfeiture questions for remand."
    }
  ],
