{
  "$defs": {
    "PerformanceMovement": {
      "additionalProperties": false,
      "description": "How one series moved between two boards, and what the move trips.\n\nAn operational alarm over two refreshes of one artifact. A change between\ntwo boards is not a finding about a predictor (``metrics/README.md``).",
      "properties": {
        "event_accuracy_after": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Accuracy After"
        },
        "event_accuracy_before": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Accuracy Before"
        },
        "events_after": {
          "title": "Events After",
          "type": "integer"
        },
        "events_before": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null where the earlier board carried no such series",
          "title": "Events Before"
        },
        "flags": {
          "description": "On a series of at least ten events, `at-or-below-floor`: event accuracy does not clear the always-deny floor, and `negative-skill`: the prior-Term Brier skill is below zero. On any series, `events-removed`: the series holds fewer events than before; `rescored`: accuracy moved by more than the added events can explain, so earlier cells were re-scored, re-windowed or left the population",
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "mean_brier_after": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Brier After"
        },
        "mean_brier_before": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Brier Before"
        },
        "predictor_id": {
          "title": "Predictor Id",
          "type": "string"
        },
        "process_window": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Process Window"
        },
        "skill_after": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill After"
        },
        "skill_before": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill Before"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "predictor_id",
        "stage",
        "events_after"
      ],
      "title": "PerformanceMovement",
      "type": "object"
    },
    "PerformancePoint": {
      "additionalProperties": false,
      "description": "One forward series' figures as one committed leaderboard carried them.\n\nA series is a (predictor, counting window, stage) triple; ``process_window``\nnull is the predictor's pooled record across its windows. Every figure is\ncopied from the board's own forward stratum, never recomputed.",
      "properties": {
        "event_accuracy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Accuracy"
        },
        "event_always_deny_accuracy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Always Deny Accuracy"
        },
        "events": {
          "description": "The stratum's `accuracy_events_scored`",
          "minimum": 0,
          "title": "Events",
          "type": "integer"
        },
        "gradings": {
          "description": "The stratum's `evaluations`",
          "minimum": 0,
          "title": "Gradings",
          "type": "integer"
        },
        "mean_brier_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Brier Score"
        },
        "mean_reasoning_quality": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Reasoning Quality"
        },
        "population_brier_skill_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population Brier Skill Score"
        },
        "population_realized_term_skill_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population Realized Term Skill Score"
        },
        "predictor_id": {
          "title": "Predictor Id",
          "type": "string"
        },
        "process_window": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The counting window, or null for the pooled record",
          "title": "Process Window"
        },
        "stage": {
          "description": "`<stage>@<moment>`; the ranked cert board is `cert@distribution`",
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "predictor_id",
        "stage",
        "events",
        "gradings"
      ],
      "title": "PerformancePoint",
      "type": "object"
    },
    "PerformanceRevision": {
      "additionalProperties": false,
      "description": "One landing of ``metrics/leaderboard.json`` on the history's ref.",
      "properties": {
        "commit": {
          "description": "The first-parent commit that landed the board",
          "title": "Commit",
          "type": "string"
        },
        "landed": {
          "description": "That commit's committer date, UTC",
          "format": "date",
          "title": "Landed",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/PerformancePoint"
          },
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "commit",
        "landed"
      ],
      "title": "PerformanceRevision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``fedcourts performance-history`` \u2014 the forward record across committed boards.\n\nRead from the first-parent history of ``metrics/leaderboard.json`` on a\nref, oldest landing first, so the committed boards are the record and\nnothing is stored twice. Each counting window is its own series and the\npooled record is a separate one; a new window is never a continuation of\nthe one before it. Descriptive: a week-over-week change is not a finding.",
  "properties": {
    "movements": {
      "description": "The newest readable board against the one before it, one row per series the newer board carries",
      "items": {
        "$ref": "#/$defs/PerformanceMovement"
      },
      "title": "Movements",
      "type": "array"
    },
    "ref": {
      "description": "The ref whose first-parent history was read",
      "title": "Ref",
      "type": "string"
    },
    "revisions": {
      "items": {
        "$ref": "#/$defs/PerformanceRevision"
      },
      "title": "Revisions",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "unreadable": {
      "description": "Commits whose board does not parse under the current schema, oldest first; their figures are absent, not zero",
      "items": {
        "type": "string"
      },
      "title": "Unreadable",
      "type": "array"
    }
  },
  "required": [
    "ref"
  ],
  "title": "PerformanceHistory",
  "type": "object"
}
